# Copy to .env and fill in your values (never commit .env)

# Splunk Enterprise HEC
SPLUNK_HEC_URL=https://localhost:8088
SPLUNK_HEC_TOKEN=your-hec-token-here
SPLUNK_HEC_SSL_VERIFY=false

# Splunk Management API (used by Argus agent via official MCP)
SPLUNK_MGMT_URL=https://localhost:8089
SPLUNK_USER=your-splunk-username
SPLUNK_PASS=your-splunk-password
SPLUNK_VERIFY_TLS=false

# Etherscan (free tier: 5 calls/sec)
ETHERSCAN_API_KEY=your-etherscan-key-here

# Alchemy (multi-chain RPC)
ALCHEMY_API_KEY=your-alchemy-key-here

# Chains RPC endpoints (auto-built from Alchemy key if set)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
OPT_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
AVAX_RPC_URL=https://avax-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Ingestion settings
POLL_INTERVAL_SECONDS=60
LOOKBACK_BLOCKS=1000
LOG_LEVEL=INFO
