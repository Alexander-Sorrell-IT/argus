## Argus — public-repo .gitignore
## Level 2 safety strip: keep proprietary/tuned/offensive artifacts out of any
## published version. The PRIVATE branch can override these by committing
## explicitly with `git add -f`.

# ── secrets / env ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.lic
*.pem
*.key

# ── findings / outputs (private to operator) ─────────────────────────
poc/findings/*
!poc/findings/.gitkeep
logs/

# Foundry build artifacts under any finding workspace (never ship build junk)
poc/findings/*/out/
poc/findings/*/cache/
poc/findings/*/lib/

# ── private tuned artifacts (kept in private fork, not in public) ────
# To publish privately tuned versions, branch off `private/main` instead
agent/submission_template.py
agent/foundry_gen.py

# ── massive vendored corpora (not needed by users; documented in README) ──
layerzero-src/
agent/audit_text/
models/

# ── bug-hunter scratch ──────────────────────────────────────────────
bug-hunter/

# ── deprecated custom MCP server (we use the official Splunk MCP) ───
splunk-mcp/

# ── deprecated MCP/SAIA agent path (ROADMAP, not the live loop) ──────
# The live agent is splunk/bin/argus_agent.py (a Splunk modular input).
# mcp_agent.py is kept in the private branch for reference only and must
# NOT ship in the public repo.
agent/mcp_agent.py
# splunk_mcp_client.py SHIPS (live SAIA client; saia_generate_detection.py
# depends on it) — intentionally NOT ignored.

# ── demo render artifacts (large; regenerated locally, never committed) ──
# Keep architecture.png IN the repo — it is a required deliverable.
demo/work/
demo/shots/
demo/voice/
demo/argus_demo.mp4
demo/argus_trailer.mp4
demo/mermaid.min.js

# ── runtime junk ────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
*.swp
splunk-mcp/.git/

# combined cut (host externally)
demo/argus_full.mp4
poc/capability-selftest/lib/
poc/capability-selftest/out/
poc/capability-selftest/cache/
demo/trailer/raw/

# Internal orchestration scratch + readiness report — never ship
.argus_readiness_workflow.js
.argus_fix_workflow.js
SUBMISSION_READINESS.md

# No demo videos in the repo — they are uploaded to YouTube/Vimeo, not shipped
demo/*.mp4

# Build/scratch from this session
.argus_*.js
poc/replays/

# agent-drafted exploit tests (ephemeral, regenerated per run)
poc/findings/.auto/
