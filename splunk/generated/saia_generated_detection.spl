# Detection AUTHORED BY the Splunk AI Assistant (SAIA) from a plain-English
# threat description, via Argus. Review before scheduling.
# Prompt: Alert when a single LayerZero endpoint sends more than 5x its 7-day average message volume in one hour

index=* sourcetype=layerzero_events endpoint=* earliest=-7d@d latest=now
| bin _time span=1h
| stats count as hour_count by endpoint _time
| eventstats sum(hour_count) as total_7d by endpoint
| eval avg_hourly = total_7d/(7*24)
| where hour_count > 5*avg_hourly
| rename endpoint as LayerZero_Endpoint, hour_count as message_volume, avg_hourly as avg_message_volume
| eval severity_level = 4
| fields _time LayerZero_Endpoint message_volume avg_message_volume severity_level
