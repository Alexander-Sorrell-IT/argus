# Detection AUTHORED BY the Splunk AI Assistant (SAIA) from a plain-English
# threat description, via Argus. Review before scheduling.
# Prompt: Alert when a single from_address sends more than 20 failed transactions across any contracts within one hour

index=omni_guard_security sourcetype="layerzero:transaction" failed_tx=1
| bin _time span=1h
| stats count as failed_tx_count by from_address _time
| where failed_tx_count > 20
| fields from_address failed_tx_count _time
